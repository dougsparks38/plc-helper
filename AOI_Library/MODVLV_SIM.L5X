<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="FullyOpened_hwdi" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Simulated fully opened limit switch: on 60 seconds after an open command (Position_CMD_hwao at or above 100)]]>
