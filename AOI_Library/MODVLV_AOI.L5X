<!--simple modulating valve control.
Note: Use with MODVALVE_PIDE_AOI if you need to control valve position with a PIDE command-->
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="38.01" TargetName="MODVLV_AOI" TargetType="AddOnInstructionDefinition" TargetRevision="1.0 " TargetLastEdited="2026-10-30T22:50:00.000Z" ContainsContext="true" ExportDate="Fri Oct 30 17:36:18 2026" ExportOptions="References NoRawData L5KData DecoratedData Context Dependencies ForceProtectedEncoding AllProjDocTrans">
