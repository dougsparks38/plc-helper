<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[***** timer presets *****]]>
</Comment>
<Text>
<![CDATA[[MUL(FailOpen_tmr_preset,1000,_FailOpen_tmr.PRE) ,MUL(FailClose_tmr_preset,1000,_FailClose_tmr.PRE) ,MUL(CHFault_tmr_preset,1000,_CHFault_tmr.PRE) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[***** config type: 1 = fully opened / fully closed limit switches, no analog position feedback. Any other value = analog position feedback *****]]>
</Comment>
<Text>
<![CDATA[EQ(config_type,1)OTE(_configType1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[***** Input rung *****
config_type 1: position for display is the command, or 100 / 0 when the open / closed limit is made]]>
</Comment>
<Text>
<![CDATA[[XIO(_configType1) MOVE(Position_FDBK_hwai,Position_scai) ,XIC(_configType1) MOVE(Position_CMD_hwao,Position_scai) ,XIC(_configType1) XIC(FullyOpened_hwdi) MOVE(100,Position_scai) ,XIC(_configType1) XIC(FullyClosed_hwdi) MOVE(0,Position_scai) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[***** Output rung *****
config_binary 1: Auto Call = 100%, else 0%. config_binary 0: Auto Call = Position_SP clamped 0 to 100%, else 0%]]>
</Comment>
<Text>
<![CDATA[[XIC(config_binary) XIC(AutoCall) MOVE(100,Position_CMD_hwao) ,XIO(config_binary) XIC(AutoCall) MOVE(Position_SP,Position_CMD_hwao) ,XIO(config_binary) XIC(AutoCall) GT(Position_CMD_hwao,100) MOVE(100,Position_CMD_hwao) ,XIO(config_binary) XIC(AutoCall) LT(Position_CMD_hwao,0) MOVE(0,Position_CMD_hwao) ,XIO(AutoCall) MOVE(0,Position_CMD_hwao) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[***** ALARMS *****]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[***** Alarm: FailOpn: Valve Failed to Open alarm *****
config_type 1: arms only when commanded fully open (Position_CMD_hwao at 100) and the open limit is not made]]>
</Comment>
<Text>
<![CDATA[[XIO(_configType1) XIC(AutoCall) LE(Position_scai,config_pos_fullyOpened) ,XIC(_configType1) GE(Position_CMD_hwao,100) XIO(FullyOpened_hwdi) ]XIO(FailOpen_alm_dis)XIO(FailOpen_alm_res)[TON(_FailOpen_tmr,?,?) ,XIC(_FailOpen_tmr.DN) OTE(FailOpen_alm) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[***** Alarm: FailCls: Valve Failed to Close alarm *****
config_type 1: arms only when commanded fully closed (Position_CMD_hwao at 0) and the closed limit is not made]]>
</Comment>
<Text>
<![CDATA[[XIO(_configType1) XIO(AutoCall) GE(Position_scai,config_pos_fullyClosed) ,XIC(_configType1) LE(Position_CMD_hwao,0) XIO(FullyClosed_hwdi) ]XIO(FailClose_alm_dis)XIO(FailClose_alm_res)[TON(_FailClose_tmr,?,?) ,XIC(_FailClose_tmr.DN) OTE(FailClose_alm) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[***** Alarm: CHFault: Analog Output Channel Fault alarm *****]]>
</Comment>
<Text>
<![CDATA[XIO(_configType1)[XIC(OverRange_hwdi) ,XIC(UnderRange_hwdi) ,XIC(Fault_hwdi) ]XIO(CHFault_alm_dis)XIO(CHFault_alm_res)[TON(_CHFault_tmr,?,?) ,XIC(_CHFault_tmr.DN) OTE(CHFault_alm) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(AUTO_PB_scdo)OTL(AUTO_scdi)OTU(MAN_scdi);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(MAN_PB_scdo)OTL(MAN_scdi)OTU(AUTO_scdi);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Valve State:
Assuming NC valve, ON = OPEN
99 = I/O error
0 = Green = Open
1 = Red = Closed
2 = Yellow = traveling
note: If the valve is NC, states 0 and 1 will be reversed.
config_type 1: open limit only = 0, closed limit only = 1, neither = 2, both = 99
]]>
</Comment>
<Text>
<![CDATA[[XIO(_configType1) MOVE(99,State) ,XIO(_configType1) GE(Position_scai,config_pos_fullyOpened) MOVE(0,State) ,XIO(_configType1) LE(Position_scai,config_pos_fullyClosed) MOVE(1,State) ,XIO(_configType1) LIMIT(config_pos_fullyClosed,Position_scai,config_pos_fullyOpened) MOVE(2,State) ,XIC(_configType1) MOVE(99,State) ,XIC(_configType1) XIC(FullyOpened_hwdi) XIO(FullyClosed_hwdi) MOVE(0,State) ,XIC(_configType1) XIC(FullyClosed_hwdi) XIO(FullyOpened_hwdi) MOVE(1,State) ,XIC(_configType1) XIO(FullyOpened_hwdi) XIO(FullyClosed_hwdi) MOVE(2,State) ];]]>
