<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Runtime timer]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Timer to track the Hourly Runtime in 1/2 hour increments (1,800,000 Milliseconds).]]>
</Comment>
<Text>
<![CDATA[XIC(Running_hwdi)RTO(_RUNTMR,?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[When the retentive timer is done add 0.5 hours to the runtime hour register and reset the timer]]>
</Comment>
<Text>
<![CDATA[XIC(_RUNTMR.DN)ADD(HOURS_scai,0.5,HOURS_scai)ADD(MONTH_HOURS_scai,0.5,MONTH_HOURS_scai)RES(_RUNTMR);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[When day of month goes back to 1, reset the month total]]>
</Comment>
<Text>
<![CDATA[EQ(WallClock_Day,1)ONS(_MonthRun_Hours_Reset_ONS)MOVE(MONTH_HOURS_scai,PREV_MONTH_HOURS_scai)MOVE(0,MONTH_HOURS_scai);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Reset the pump runtime hours if the SCADA reset button is clicked -OR- the number of hours gets too large (32000 hours).
]]>
</Comment>
<Text>
<![CDATA[[XIC(RESETTMR_scdo) ,GT(HOURS_scai,32000) ]CLR(HOURS_scai)RES(_RUNTMR);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(AUTO_PB_scdo)OTE(AUTO_scdi);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(AUTO_PB_scdo)OTE(MAN_scdi);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(AUTO_hwdi)[XIC(AUTO_scdi) XIC(AutoCall_scdi) XIO(AutoCall_INTRLK_scdi) ,XIC(MAN_scdi) [XIC(START_scdo) ,XIC(RUN_hwdo) XIO(STOP_scdo) ] ]XIO(FAIL_alm)XIC(INTRLK_scdi)XIO(DriveFault_alm)OTE(RUN_hwdo);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(AUTO_hwdi)[XIC(AUTO_scdi) XIC(AutoCall_scdi) XIO(AutoCall_INTRLK_scdi) ,XIC(MAN_scdi) [XIC(_ENABLE_PB_scdo) ,XIC(_ENABLE_hwdo) XIO(_DISABLE_PB_scdo) ] ]XIO(FAIL_alm)XIC(INTRLK_scdi)XIO(DriveFault_alm)OTE(_ENABLE_hwdo);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Pump Failure Alarm]]>
</Comment>
<Text>
<![CDATA[XIC(RUN_hwdo)XIO(Running_hwdi)XIO(FAIL_alm_dis)XIO(Disable_Alarms)XIO(FAIL_alm_res)XIO(Global_Alm_Reset)TON(_FAILTMR,?,?);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(_FAILTMR.DN)OTL(FAIL_alm);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIO(AUTO_hwdi) XIC(Running_hwdi) ,XIC(FAIL_alm_dis) ,XIC(Disable_Alarms) ,XIC(FAIL_alm_res) ,XIC(Global_Alm_Reset) ]OTU(FAIL_alm);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[VFD Fault alarm]]>
</Comment>
<Text>
<![CDATA[[XIC(DriveFault_hwdi) XIO(DriveFault_Invert) ,XIO(DriveFault_hwdi) XIC(DriveFault_Invert) ]XIO(Disable_Alarms)XIO(DriveFault_alm_dis)XIO(DriveFault_alm_res)XIO(Global_Alm_Reset)TON(_DriveFaultTMR,?,?);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(_DriveFaultTMR.DN)OTE(DriveFault_alm);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Pump Failure Alarm]]>
</Comment>
<Text>
<![CDATA[[XIC(ALRM_hwdi) XIO(ALRM_Invert) ,XIO(ALRM_hwdi) XIC(ALRM_Invert) ]XIO(Disable_Alarms)XIO(ALRM_dis)XIO(ALRM_res)XIO(Global_Alm_Reset)TON(_ALRM_TMR,?,?);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(_ALRM_TMR.DN)OTE(ALRM);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Pump Failure Alarm]]>
</Comment>
<Text>
<![CDATA[[XIC(CBAux_hwdi) XIO(CBAux_Invert) ,XIO(CBAux_hwdi) XIC(CBAux_Invert) ]XIO(Disable_Alarms)XIO(CBAux_Alm_dis)XIO(CBAux_Alm_res)XIO(Global_Alm_Reset)TON(_CBAux_Alm_TMR,?,?);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(_CBAux_Alm_TMR.DN)OTE(CBAux_alm);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[GE(Current_hwai,CURRENT_HiAlm_SP)XIO(Disable_Alarms)XIC(Running_hwdi)XIO(CURRENT_HiAlm_res)XIO(CURRENT_HiAlm_dis)XIO(Global_Alm_Reset)TON(_CurrentHiTMR,?,?);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(_CurrentHiTMR.DN)OTL(CURRENT_HiAlm);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[[XIO(AUTO_hwdi) XIC(Running_hwdi) ,XIC(CURRENT_HiAlm_dis) ,XIC(Disable_Alarms) ,XIC(CURRENT_HiAlm_res) ,XIC(Global_Alm_Reset) ]OTU(CURRENT_HiAlm);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[LT(Current_hwai,CURRENT_LoAlm_SP)XIO(Disable_Alarms)XIC(Running_hwdi)XIO(CURRENT_LoAlm_res)XIO(CURRENT_LoAlm_dis)XIO(Global_Alm_Reset)TON(_CurrentLoTMR,?,?);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(_CurrentLoTMR.DN)OTL(CURRENT_LoAlm);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[[XIO(AUTO_hwdi) XIC(Running_hwdi) ,XIC(CURRENT_LoAlm_dis) ,XIC(Disable_Alarms) ,XIC(CURRENT_LoAlm_res) ,XIC(Global_Alm_Reset) ]OTU(CURRENT_LoAlm);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIO(Disable_Alarms)XIC(ChFault_hwdi)XIO(ChFault_alm_dis)XIO(ChFault_alm_res)OTE(ChFault_alm);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[XIO(Disable_Alarms)XIC(OpenWire_hwdi)XIO(OpenWire_alm_dis)XIO(OpenWire_alm_res)OTE(OpenWire_alm);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[MUL(Stuck_On_Alm_Time_Setpoint,60000,_Stuck_On_Alm_tmr.PRE);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[XIC(Running_hwdi)XIO(Stuck_On_Alm_dis)XIO(Stuck_On_Alm_res)TON(_Stuck_On_Alm_tmr,?,?);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[XIC(_Stuck_On_Alm_tmr.DN)OTL(Stuck_On_Alm);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[[XIO(AUTO_hwdi) XIO(Running_hwdi) ,XIC(Stuck_On_Alm_dis) ,XIC(Disable_Alarms) ,XIC(Stuck_On_Alm_res) ,XIC(Global_Alm_Reset) ]OTU(Stuck_On_Alm);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[HOA status integer is used for HMI indication of selector switch position]]>
</Comment>
<Text>
<![CDATA[XIC(MAN_hwdi)MOVE(-1,HOA_STATUS_scai);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[XIO(MAN_hwdi)XIO(AUTO_hwdi)MOVE(0,HOA_STATUS_scai);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[XIC(AUTO_hwdi)MOVE(1,HOA_STATUS_scai);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[Motor status integer is used for diagnostics and HMI motor status indication]]>
</Comment>
<Text>
<![CDATA[XIO(Running_hwdi)XIO(FAIL_alm)XIO(DriveFault_alm)MOVE(0,MOTOR_STATUS_scai);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[XIC(Running_hwdi)XIO(FAIL_alm)XIO(DriveFault_alm)MOVE(1,MOTOR_STATUS_scai);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[[XIC(FAIL_alm) ,XIC(DriveFault_alm) ]MOVE(2,MOTOR_STATUS_scai);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[XIC(AUTO_hwdi)XIC(AUTO_scdi)MOVE(1,AUTO_STATUS_scai);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Text>
<![CDATA[XIO(AUTO_scdi)MOVE(2,AUTO_STATUS_scai);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Text>
<![CDATA[XIO(AUTO_hwdi)MOVE(3,AUTO_STATUS_scai);]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Text>
<![CDATA[XIO(AUTO_hwdi)XIO(AUTO_scdi)MOVE(4,AUTO_STATUS_scai);]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Text>
<![CDATA[XIC(MAN_hwdi)MOVE(5,AUTO_STATUS_scai);]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Comment>
<![CDATA[SCADA stop: latch stop status, clear start status. Must run before the unlatch rung below.]]>
</Comment>
<Text>
<![CDATA[XIC(STOP_scdo)OTL(STOP_scdi)OTU(START_scdi);]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Comment>
<![CDATA[SCADA start: latch start status, clear stop status. Must run before the unlatch rung below.]]>
</Comment>
<Text>
<![CDATA[XIC(START_scdo)OTL(START_scdi)OTU(STOP_scdi);]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Comment>
<![CDATA[Unlatch scada manual start bits. Momentary buttons in Ignition are buggy and stick on sometimes.]]>
</Comment>
<Text>
<![CDATA[[OTU(START_scdo) ,OTU(STOP_scdo) ,OTU(FAIL_alm_res) ,OTU(DriveFault_alm_res) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
</Controller>
</RSLogix5000Content>
